# Instellingen voor één Gripp-account.
# Kopieer dit bestand naar profiles/<naam>/config.env, bijvoorbeeld profiles/mijnbedrijf/config.env.
# Profielen staan nooit in git (zie .gitignore); deel dit bestand dus niet met een ingevuld token.

# Verplicht: API-sleutel uit Gripp (Instellingen › API keys).
# Advies: maak een nieuwe sleutel met een API-rol die alleen mag lezen.
GRIPP_API_TOKEN=

# Naam die in het archief wordt getoond.
GRIPP_ACCOUNT_NAME=

# Optioneel: waar de back-up komt te staan (map wordt aangemaakt).
# Standaard: backups/<naam> in deze map. Kies bij voorkeur een korte map buiten de tool,
# bijvoorbeeld D:\Back-ups\Gripp of een NAS-share.
# GRIPP_BACKUP_DIR=

# Optioneel: ook PDF's van offertes, opdrachten en inkoopopdrachten ophalen (aan/uit, standaard uit).
# Let op: Gripp kan het openen van de online weergave als "bekeken" in de timeline zetten.
# GRIPP_DOCUMENTS=aan

# Optioneel: aantal oudere snapshots dat bewaard blijft (standaard 7, minimaal 1).
# GRIPP_KEEP_SNAPSHOTS=7

# Optioneel: andere API-endpoint (standaard de officiële).
# GRIPP_API_URL=https://api.gripp.com/public/api3.php
