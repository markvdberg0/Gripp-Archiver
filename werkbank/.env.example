# Werkbank — voorbeeldconfiguratie. Kopieer naar .env en pas aan. Dit bestand bevat GEEN geheimen;
# zet echte wachtwoorden en sleutels alleen in .env (dat staat nooit in git).

APP_NAME=Werkbank
APP_ENV=production
# Genereer met: php artisan key:generate   (verlies deze sleutel niet: zonder sleutel geen sessies of versleutelde velden)
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Amsterdam
APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30

# Database. Standaard SQLite (één bestand: database/database.sqlite).
DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/html/database/database.sqlite
# MariaDB/MySQL of PostgreSQL:
# DB_CONNECTION=mariadb
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=werkbank
# DB_USERNAME=werkbank
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
# Zet op true zodra Werkbank via https bereikbaar is.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# E-mail (bijvoorbeeld voor wachtwoordherstel). 'log' schrijft mails naar het logbestand.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="werkbank@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Bankkoppeling via Ponto (alleen lezen), zie docs/bankkoppeling-ponto.md. Leeg = uit.
# Certificaat en sleutel alleen invullen als Ponto ze voor je integratie vereist.
PONTO_CLIENT_ID=
PONTO_CLIENT_SECRET=
PONTO_CERT_PATH=
PONTO_KEY_PATH=
PONTO_KEY_PASSPHRASE=

# Back-upmap van de Gripp Back-up waaruit geïmporteerd wordt (map met data/ en archive/).
# In Docker: koppel die map alleen-lezen aan /import en zet hier /import.
WERKBANK_IMPORT_PATH=

# Back-ups van Werkbank zelf (php artisan werkbank:backup).
WERKBANK_BACKUP_PATH=
WERKBANK_BACKUP_KEEP=14

# Maximale grootte van een upload in kB.
WERKBANK_MAX_UPLOAD_KB=20480
